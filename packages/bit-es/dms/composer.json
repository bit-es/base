{
    "name": "bit-es/dms",
    "description": "This is bites package for Document Management System",
    "keywords": [
        "bit-es",
        "dms",
        "document",
        "filament"
    ],



    "homepage": "https://github.com/bit-es/dms",
    "support": {
        "issues": "https://github.com/bit-es/dms/issues",
        "source": "https://github.com/bit-es/dms"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "bit-es",
            "email": "bit.ecosystem@gmail.com",
            "role": "Developer"
        }
    ],


    "require": {
        "php": "^8.2",
        "bit-es/core": "dev-main",
        "filament/filament": "^4.0"
    },





    "require-dev": {
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^3.7",
        "pestphp/pest-plugin-laravel": "^3.1"
    },
    "autoload": {
        "psr-4": {
            "Bites\\Dms\\": "src/"
        }
    },





    "scripts": {
        "post-autoload-dump": [
            "@php artisan migrate"


        ],






        "post-update-cmd": [],
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage"
    },



    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },




    "extra": {
        "laravel": {
            "providers": [
                "Bites\\Dms\\DmsServiceProvider",
                "Bites\\Dms\\Providers\\DmsPanelProvider"



            ],
            "aliases": {
                "Eam": "Bites\\Dms\\Facades\\Dms"




            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}

