{
    "name": "bit-es/core",
    "description": "This is bites package on core models that maybe used by any other models as its attributes",
    "keywords": [
        "bit-es",
        "core",
        "laravel",
        "filament"
    ],



    "homepage": "https://github.com/bit-es/core",
    "support": {
        "issues": "https://github.com/bit-es/core/issues",
        "source": "https://github.com/bit-es/core"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "bit-es",
            "email": "bit.ecosystem@gmail.com",
            "role": "Developer"
        }
    ],


    "require": {
        "php": "^8.2",
        "filament/filament": "^4.0",
        "laravel/framework": "^12.0",
        "spatie/laravel-permission": "^6.21"
    },




    "require-dev": {
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^3.7",
        "pestphp/pest-plugin-laravel": "^3.1"
    },
    "autoload": {
        "psr-4": {
            "Bites\\Core\\": "src/"
        }
    },





    "scripts": {
        "post-autoload-dump": [
            "@php artisan migrate",
            "@php artisan filament:install --silent"



        ],




        "post-update-cmd": [],
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage"
    },



    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },




    "extra": {
        "laravel": {
            "providers": [
                "Bites\\Core\\CoreServiceProvider",
                "Bites\\Core\\Providers\\CorePanelProvider",
                "Bites\\Core\\Providers\\StaffPanelProvider",
                "Bites\\Core\\Providers\\GuestPanelProvider"

            ],
            "aliases": {
                "Core": "Bites\\Core\\Facades\\Core"




            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}

